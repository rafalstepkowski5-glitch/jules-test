{
  "name": "WebX Metrics Pro - Rust + SQLCipher",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Axum API",
      "onAutoForward": "notify"
    }
  }
}
